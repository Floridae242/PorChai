# Copy to .env.local and fill in. Never commit real values — this repo is public.

# LINE Messaging API channel 2012545691 (LINE OA: chat + reminders)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public HTTPS origin that serves /mascot/*.png for LINE Flex cards. No token/query string.
# On Vercel, defaults to https://VERCEL_PROJECT_PRODUCTION_URL (system env vars enabled).
# Without either origin, cards still work with text and buttons; LIFF serves local animations.
LINE_ASSET_BASE_URL=

# LINE MINI App channel (screens). Channel ID is used to verify ID tokens on the server.
NEXT_PUBLIC_LIFF_ID=2012545254-6025ZG1r
LINE_MINIAPP_CHANNEL_ID=2012545254
NEXT_PUBLIC_LINE_OA_BASIC_ID=@919xmahr
# Audience for shared backend APIs: set to the channel that issued their LIFF ID token.
# This Developing MINI App uses 2012545254, not the Messaging API channel.
# A separate LINE Login/LIFF deployment must use its own matching channel ID.
LINE_LOGIN_CHANNEL_ID=2012545254

# Supabase. The service role key is server-only: screens talk to our API, never to the database directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase (supabase start): get values from `supabase status -o env`.
# DB tests read them from .env.test.local (git-ignored), see README.
# Only for DB tests (RLS check): the anon key. Never used by app code.
SUPABASE_ANON_KEY=

# Frontend data source. "mock" = in-memory demo data, never loads LIFF (add ?scenario=fresh|default|midCycle|shortfall|tight|paydayPassed to the URL).
# "live" = real API with a LINE ID token (open inside LIFF). Unset = mock under next dev.
# Production builds always use live, even if NEXT_PUBLIC_API_MODE=mock is set.
# NEXT_PUBLIC_API_MODE=mock
