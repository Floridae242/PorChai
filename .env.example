# Copy to .env.local and fill in. Never commit real values — this repo is public.

# LINE Messaging API channel (LINE OA: chat + reminders)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel with the LIFF app (screens). Channel ID is used to verify ID tokens on the server.
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# Supabase. The service role key is server-only: screens talk to our API, never to the database directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase (supabase start): get values from `supabase status -o env`.
# DB tests read them from .env.test.local (git-ignored), see README.
# Only for DB tests (RLS check): the anon key. Never used by app code.
SUPABASE_ANON_KEY=

# Frontend data source. "mock" = in-memory demo data, never loads LIFF (add ?scenario=fresh|default|midCycle|shortfall|tight|paydayPassed to the URL).
# "live" = real API with a LINE ID token (open inside LIFF). If unset: mock under next dev, live in production builds.
# NEXT_PUBLIC_API_MODE=mock
